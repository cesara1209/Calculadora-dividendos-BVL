<body class="min-h-screen">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5PZ7W56N"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <nav class="gradient-bg text-white py-6 shadow-xl mb-8">
        <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="text-center md:text-left">
                <h1 class="text-2xl font-extrabold tracking-tight">Calculadora de Dividendos - <span class="text-blue-400">BVL</span> | César AT</h1>
                <p class="text-xs text-blue-200 font-medium opacity-90 uppercase tracking-widest">Plataforma gratuita de proyección de dividendos</p>
            </div>
            <div class="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full border border-white/20">
                <span class="h-2 w-2 rounded-full bg-blue-400"></span>
                <span class="text-xs font-bold">Comisiones PEN/USD Actualizadas</span>
            </div>
        </div>
    </nav>

    <main class="max-w-6xl mx-auto px-6 pb-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            
            <!-- SECCIÓN DE PARÁMETROS -->
            <div class="lg:col-span-4 space-y-6">
                <div class="glass-effect p-8 rounded-3xl card-shadow border-2 border-blue-100">
                    <h2 class="text-lg font-bold mb-6 flex items-center text-slate-800">
                        <svg class="w-5 h-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                        Parámetros de Cálculo
                    </h2>

                    <div class="space-y-5">
                        <!-- Selección de Activo -->
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-2 tracking-wide">1. Seleccionar Acción</label>
                            <select id="tickerSelect" class="w-full p-4 bg-slate-50 rounded-2xl border border-slate-200 outline-none text-slate-700 font-medium focus:ring-2 focus:ring-blue-500 transition-all cursor-pointer">
                                <option value="">Cargando base de datos...</option>
                            </select>
                        </div>

                        <!-- Capital -->
                        <div>
                            <label class="block text-xs font-bold text-slate-500 uppercase mb-2 tracking-wide">2. Capital a Invertir</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <span class="currencyInputLabel text-slate-400 font-bold">$</span>
                                </div>
                                <input type="number" id="investmentAmount" placeholder="0.00" class="w-full p-4 pl-12 bg-slate-50 rounded-2xl border border-slate-200 outline-none font-bold text-slate-800 focus:ring-2 focus:ring-blue-500 transition-all">
                            </div>
                        </div>

                        <!-- Comision SAB -->
                        <div class="bg-blue-50/50 p-4 rounded-2xl border border-blue-100">
                            <label class="block text-[10px] font-bold text-blue-600 uppercase mb-1 tracking-wide">Comisión Kallpa SAB estimada</label>
                            <div class="flex justify-between items-center">
                                <span id="comissionTag" class="text-[10px] text-blue-500 font-medium">Esperando monto...</span>
                                <span class="text-sm font-bold text-blue-700"><span class="currencyInputLabel">$</span> <span id="sabFeeVal">0.00</span></span>
                            </div>
                            <p id="feeRulesText" class="text-[9px] text-blue-400 mt-1 leading-tight">* Seleccione una acción para ver las reglas de comisión.</p>
                        </div>

                        <!-- Precio Manual -->
                        <div>
                            <label class="block text-xs font-bold text-blue-600 uppercase mb-2 tracking-wide">3. Precio Actual (Manual)</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <span class="currencyInputLabel text-blue-300 font-bold">$</span>
                                </div>
                                <input type="number" id="stockPriceManual" step="0.01" placeholder="Ej: 15.40" class="w-full p-4 pl-12 bg-blue-50 rounded-2xl border-2 border-blue-200 outline-none font-bold text-blue-800 shadow-sm focus:bg-white focus:border-blue-500 transition-all">
                            </div>
                        </div>

                        <!-- BOTÓN DE CÁLCULO -->
                        <button id="btnCalculateMoney" class="btn-calculate w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 rounded-2xl shadow-lg shadow-blue-200 flex flex-col items-center justify-center gap-1 group">
                            <span class="text-sm uppercase tracking-wider">¿Cuánto dinero recibiré?</span>
                            <span class="text-[10px] opacity-75 font-medium">Considerando descuento de comisión</span>
                        </button>

                        <div id="statusMessage" class="text-[10px] font-bold uppercase py-2 text-slate-400 border-t border-slate-100 mt-4">
                            Estado: Conectado a Google Sheets
                        </div>
                    </div>
                </div>

                <!-- QR COLABORACIÓN -->
                <div class="glass-effect p-8 rounded-3xl card-shadow text-center">
                    <p class="text-xs font-bold text-slate-400 uppercase mb-4 tracking-widest">Colaboración</p>
                    <div class="bg-white p-3 rounded-2xl shadow-inner inline-block mb-4 border border-slate-100">
                        <img id="qrImage" src="https://lh3.googleusercontent.com/d/1NoXQtziAh7bBLBv2a4i5OCKNN--7XZyE" alt="QR Yape" class="w-40 h-40 rounded-lg object-contain" onerror="this.src='https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=ErrorLinkDrive'">
                    </div>
                    <p class="text-[11px] text-slate-600 font-bold uppercase tracking-tighter mb-2">Apóyanos con un Yape</p>
                    <p class="text-[10px] text-slate-400 leading-relaxed px-4 italic">Con tu apoyo desde S/3.00 permites mantener esta herramienta gratuita para toda la comunidad.</p>
                </div>
            </div>

            <!-- SECCIÓN DE RESULTADOS -->
            <div class="lg:col-span-8 space-y-6">
                <div id="resultCard" class="gradient-bg p-10 rounded-[2.5rem] text-white shadow-2xl relative overflow-hidden transition-all">
                    <div class="relative z-10">
                        <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 gap-4">
                            <div>
                                <p class="text-blue-200 text-xs font-bold uppercase tracking-widest mb-2">Ingreso por dividendos aproximado antes de impuestos</p>
                                <h2 id="annualResult" class="text-6xl font-black tracking-tighter"><span class="currencyLabel">$</span> 0.00</h2>
                            </div>
                            <div id="freqTag" class="hidden bg-white/10 backdrop-blur-md border border-white/20 px-6 py-2 rounded-2xl text-xs font-black uppercase tracking-widest">
                                -
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                            <div class="bg-white/5 backdrop-blur-sm p-6 rounded-3xl border border-white/10">
                                <p class="text-blue-300 text-[10px] font-black uppercase mb-2">Acciones a Comprar</p>
                                <p id="sharesCount" class="text-2xl font-bold">0</p>
                            </div>
                            <div class="bg-white/5 backdrop-blur-sm p-6 rounded-3xl border border-white/10">
                                <p class="text-blue-300 text-[10px] font-black uppercase mb-2">Dividend Yield (Real)</p>
                                <p id="yieldVal" class="text-2xl font-bold text-green-400">0.00%</p>
                            </div>
                            <div class="bg-white/5 backdrop-blur-sm p-6 rounded-3xl border border-white/10">
                                <p class="text-blue-300 text-[10px] font-black uppercase mb-2">Dividendo x Acción</p>
                                <p id="divPerShare" class="text-2xl font-bold text-blue-100">0.0000</p>
                            </div>
                        </div>
                    </div>
                    <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-blue-500/10 rounded-full blur-[80px]"></div>
                </div>

                <!-- INFORMACIÓN ADICIONAL -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- FICHA DEL ACTIVO -->
                    <div class="p-8 bg-white rounded-[2rem] card-shadow border border-slate-100 flex flex-col gap-6">
                        <div>
                            <h4 class="text-xs font-black text-slate-400 uppercase mb-4 tracking-widest flex items-center">
                                <svg class="w-3 h-3 mr-2 text-blue-500" fill="currentColor" viewBox="0 0 20 20"><path d="M7 3a1 1 0 000 2h6a1 1 0 100-2H7zM4 7a1 1 0 011-1h10a1 1 0 110 2H5a1 1 0 01-1-1zM2 11a2 2 0 012-2h12a2 2 0 012 2v4a2 2 0 01-2 2H4a2 2 0 01-2-2v-4z"></path></svg>
                                Detalles del Activo
                            </h4>
                            <div id="assetInfo" class="space-y-3">
                                <p class="text-sm text-slate-500 italic">Seleccione una empresa para ver los detalles.</p>
                            </div>
                        </div>
                        
                        <div class="pt-4 border-t border-slate-50">
                            <h4 class="text-xs font-black text-slate-400 uppercase mb-4 tracking-widest flex items-center">
                                <svg class="w-3 h-3 mr-2 text-blue-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path></svg>
                                Cronograma de Fechas
                            </h4>
                            <div id="datesInfo" class="grid grid-cols-2 gap-3">
                                <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                    <p class="text-[9px] font-black text-slate-400 uppercase mb-1">Acuerdo</p>
                                    <p id="dateAcuerdo" class="text-xs font-bold text-slate-700">-</p>
                                </div>
                                <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                    <p class="text-[9px] font-black text-slate-400 uppercase mb-1">Corte</p>
                                    <p id="dateCorte" class="text-xs font-bold text-blue-600">-</p>
                                </div>
                                <div class="bg-slate-50 p-3 rounded-xl border border-slate-100">
                                    <p class="text-[9px] font-black text-slate-400 uppercase mb-1">Registro</p>
                                    <p id="dateRegistro" class="text-xs font-bold text-slate-700">-</p>
                                </div>
                                <div class="bg-green-50 p-3 rounded-xl border border-green-100">
                                    <p class="text-[9px] font-black text-green-600 uppercase mb-1">Entrega</p>
                                    <p id="dateEntrega" class="text-xs font-bold text-green-700">-</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CTA ASESORÍA -->
                    <div class="p-8 bg-slate-900 rounded-[2rem] shadow-xl flex flex-col justify-center text-center">
                        <p class="text-blue-400 font-black text-xs uppercase mb-2 tracking-widest">Asesoría</p>
                        <p class="text-white font-bold text-lg mb-6 leading-tight">¿Necesitas ayuda para empezar a invertir desde CERO?</p>
                        <a href="https://calendly.com/cesar-at/asesoria-en-finanzas-personales" target="_blank" id="btnAsesoria" class="bg-blue-600 text-white py-4 rounded-2xl text-sm font-bold hover:bg-blue-700 transition-all shadow-lg shadow-blue-900/20">
                            Agendar Asesoría
                        </a>
                    </div>
                </div>

                <div class="p-6 bg-slate-100 rounded-3xl border border-slate-200 border-dashed text-[11px] text-slate-500 leading-relaxed">
                    <strong>Nota sobre comisiones:</strong> 
                    <br>• <strong>PEN:</strong> S/ 12.50 hasta S/ 2000. Desde S/ 2001 se aplica 0.6%.
                    <br>• <strong>USD:</strong> $ 3.00 hasta $ 500. Desde $ 501 se aplica 0.6%.
                </div>
            </div>
        </div>
    </main>

    <script>
        const GOOGLE_SHEET_CSV = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vT2JYqBjnE5ONiypyfmLVBNMEqz5H23VXtvozRv2LnpCiOGX5Ya-sic143oT8_AVeRMK5bguz2kpQKw/pub?output=csv';
        
        let database = [];

        function pushEvent(eventName, eventParams = {}) {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
                event: eventName,
                ...eventParams
            });
        }

        async function init() {
            Papa.parse(GOOGLE_SHEET_CSV, {
                download: true,
                header: true,
                complete: (results) => {
                    database = results.data.filter(row => row.Ticker);
                    populateSelect();
                },
                error: (err) => {
                    const status = document.getElementById('statusMessage');
                    status.textContent = "Error de conexión con Excel";
                    status.classList.add('text-red-500');
                }
            });
        }

        function populateSelect() {
            const select = document.getElementById('tickerSelect');
            select.innerHTML = '<option value="">-- Seleccionar Empresa --</option>';
            database.forEach((item, index) => {
                const option = document.createElement('option');
                option.value = index;
                option.textContent = `${item.Ticker} | ${item.Empresa}`;
                select.appendChild(option);
            });
        }

        function handleTickerChange() {
            const idx = document.getElementById('tickerSelect').value;
            if (idx === "") {
                resetResults();
                return;
            }

            const stock = database[idx];
            const isSol = stock.Moneda === 'PEN';
            const symbol = isSol ? 'S/' : '$';
            const divValue = parseFloat(stock.Dividendos || 0);
            
            pushEvent('ticker_selected', { ticker: stock.Ticker, empresa: stock.Empresa });

            document.querySelectorAll('.currencyInputLabel, .currencyLabel').forEach(l => l.textContent = symbol);
            document.getElementById('divPerShare').textContent = divValue.toFixed(4);
            
            const feeRules = document.getElementById('feeRulesText');
            if (isSol) {
                feeRules.innerHTML = "* Hasta 2000: fija 12.50. Desde 2001: 0.6%.";
            } else {
                feeRules.innerHTML = "* Hasta 500: fija 3.00. Desde 501: 0.6%.";
            }
            
            // Actualizar información general
            document.getElementById('assetInfo').innerHTML = `
                <div class="flex justify-between items-center py-1">
                    <span class="text-[10px] font-bold text-slate-400 uppercase">Empresa</span>
                    <span class="text-xs font-bold text-slate-800 text-right max-w-[150px] truncate">${stock.Empresa}</span>
                </div>
                <div class="flex justify-between items-center py-1">
                    <span class="text-[10px] font-bold text-slate-400 uppercase">Moneda</span>
                    <span class="text-xs font-bold text-slate-800">${stock.Moneda}</span>
                </div>
                <div class="flex justify-between items-center py-1">
                    <span class="text-[10px] font-bold text-slate-400 uppercase">Frecuencia</span>
                    <span class="text-xs font-bold text-blue-600">${stock.Frecuencia || 'Anual'}</span>
                </div>
            `;

            // Actualizar fechas usando los nombres de columnas específicos
            document.getElementById('dateAcuerdo').textContent = stock.FechaAcuerdo || '-';
            document.getElementById('dateCorte').textContent = stock.FechaCorte || '-';
            document.getElementById('dateRegistro').textContent = stock.FechaRegistro || '-';
            document.getElementById('dateEntrega').textContent = stock.FechaEntrega || '-';

            // FOCO: Mover cursor al monto de inversión
            document.getElementById('investmentAmount').focus();
            calculate();
        }

        function calculate(visualFeedback = false) {
            const idx = document.getElementById('tickerSelect').value;
            const amount = parseFloat(document.getElementById('investmentAmount').value);
            const price = parseFloat(document.getElementById('stockPriceManual').value);

            if (isNaN(amount) || amount <= 0) {
                document.getElementById('sabFeeVal').textContent = "0.00";
                document.getElementById('comissionTag').textContent = "Esperando monto...";
                return;
            }

            const stock = idx !== "" ? database[idx] : null;
            const isSol = stock ? stock.Moneda === 'PEN' : true;
            
            let sabFee = 0;
            if (isSol) {
                if (amount <= 2000) {
                    sabFee = 12.50;
                    document.getElementById('comissionTag').textContent = "Tarifa Fija (PEN)";
                } else {
                    sabFee = amount * 0.006;
                    document.getElementById('comissionTag').textContent = "Tarifa 0.6%";
                }
            } else {
                if (amount <= 500) {
                    sabFee = 3.00;
                    document.getElementById('comissionTag').textContent = "Tarifa Fija (USD)";
                } else {
                    sabFee = amount * 0.006;
                    document.getElementById('comissionTag').textContent = "Tarifa 0.6%";
                }
            }
            document.getElementById('sabFeeVal').textContent = sabFee.toFixed(2);

            if (!stock || isNaN(price) || price <= 0) return;

            const netCapital = amount - sabFee;
            if (netCapital <= 0) {
                document.getElementById('sharesCount').textContent = "0";
                document.getElementById('annualResult').innerHTML = `<span class="currencyLabel">${isSol?'S/':'$'}</span> 0.00`;
                return;
            }

            const symbol = isSol ? 'S/' : '$';
            const divFromExcel = parseFloat(stock.Dividendos) || 0;
            
            const numShares = Math.floor(netCapital / price);
            const totalDividendIncome = numShares * divFromExcel;
            const yieldReal = (divFromExcel / price) * 100;

            document.getElementById('sharesCount').textContent = numShares.toLocaleString();
            document.getElementById('yieldVal').textContent = `${yieldReal.toFixed(2)}%`;
            document.getElementById('divPerShare').textContent = divFromExcel.toFixed(4);
            
            document.getElementById('annualResult').innerHTML = `<span class="text-3xl mr-1">${symbol}</span>${totalDividendIncome.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            
            const tag = document.getElementById('freqTag');
            tag.textContent = stock.Frecuencia || 'PAGO';
            tag.classList.remove('hidden');

            if (visualFeedback) {
                pushEvent('dividend_calculated', { ticker: stock.Ticker, amount: amount });
                const card = document.getElementById('resultCard');
                card.classList.remove('highlight-result');
                void card.offsetWidth; 
                card.classList.add('highlight-result');
            }
        }

        function resetResults() {
            document.getElementById('annualResult').innerHTML = `<span class="currencyLabel">$</span> 0.00`;
            document.getElementById('sharesCount').textContent = "0";
            document.getElementById('yieldVal').textContent = "0.00%";
            document.getElementById('divPerShare').textContent = "0.0000";
            document.getElementById('freqTag').classList.add('hidden');
            document.getElementById('assetInfo').innerHTML = `<p class="text-sm text-slate-500 italic">Seleccione una empresa para ver los detalles.</p>`;
            document.getElementById('dateAcuerdo').textContent = '-';
            document.getElementById('dateCorte').textContent = '-';
            document.getElementById('dateRegistro').textContent = '-';
            document.getElementById('dateEntrega').textContent = '-';
            document.getElementById('feeRulesText').innerHTML = "* Seleccione una acción para ver las reglas de comisión.";
        }

        document.getElementById('tickerSelect').addEventListener('change', handleTickerChange);
        document.getElementById('investmentAmount').addEventListener('input', () => calculate());
        document.getElementById('stockPriceManual').addEventListener('input', () => calculate());
        document.getElementById('btnCalculateMoney').addEventListener('click', () => calculate(true));
        
        document.getElementById('btnAsesoria').addEventListener('click', () => {
            pushEvent('click_asesoria_calendly');
        });

        init();
    </script>
</body>
</html>
