    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        :root { --brand-primary: #1e3a8a; }
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; color: #1e293b; }
        .gradient-bg { background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); }
        .glass-effect { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(8px); border: 1px solid rgba(226, 232, 240, 0.8); }
        .card-shadow { box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05); }
        input::-webkit-outer-spin-button, input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
        
        .btn-calculate {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .btn-calculate:active {
            transform: scale(0.95);
        }
        .highlight-result {
            animation: highlight 0.8s ease-out;
        }
        @keyframes highlight {
            0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.5); }
            50% { transform: scale(1.02); box-shadow: 0 0 30px 10px rgba(59, 130, 246, 0.3); }
